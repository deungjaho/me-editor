# TypeScript syntax definition for me

flags: annotations pair_squote

# Control flow, Async, Event Loop & Exceptions (Key Intent for TS/Node)
control: async
control: await
control: break
control: case
control: catch
control: continue
control: default
control: do
control: else
control: finally
control: for
control: if
control: return
control: switch
control: throw
control: try
control: while
control: yield

# Keywords (JS + TS specific)
keyword: abstract
keyword: as
keyword: class
keyword: const
keyword: declare
keyword: delete
keyword: enum
keyword: export
keyword: extends
keyword: from
keyword: function
keyword: get
keyword: import
keyword: in
keyword: instanceof
keyword: interface
keyword: let
keyword: module
keyword: namespace
keyword: new
keyword: of
keyword: private
keyword: protected
keyword: public
keyword: readonly
keyword: set
keyword: static
keyword: super
keyword: this
keyword: type
keyword: typeof
keyword: var
keyword: void
keyword: keyof
keyword: infer
keyword: is
keyword: satisfies
keyword: require
keyword: process
keyword: Buffer

# Primitive types (highlighted blue)
type: any
type: boolean
type: number
type: string
type: symbol
type: bigint
type: unknown
type: never
type: void
type: undefined

# Built-in utility types & objects (neutral sand to eliminate visual clutter)
keyword: object
keyword: Promise
keyword: Array
keyword: Record
keyword: Partial
keyword: Required
keyword: Readonly
keyword: Pick
keyword: Omit
keyword: Exclude
keyword: Extract
keyword: NonNullable
keyword: Parameters
keyword: ReturnType
keyword: InstanceType
keyword: console

# Strings
string: " "
string: ' '
string: ` `

# Comments
line_comment: //
block_comment: /* */

# Constants
constant: true
constant: false
constant: null
