# Vim script syntax definition for me
# Note: '"' starts a comment AND a string in vimscript; string rules are
# declared first so quoted strings work, at the cost of full-line comments
# rendering as string color rather than comment color.

# Control flow & Exceptions (Key Intent for Vim script)
control: break
control: catch
control: continue
control: else
control: elseif
control: endif
control: endtry
control: finally
control: for
control: endfor
control: if
control: return
control: throw
control: try
control: while
control: endwhile

# Keywords & Declarations
keyword: augroup
keyword: autocmd
keyword: call
keyword: command
keyword: def
keyword: enddef
keyword: echo
keyword: echohl
keyword: echom
keyword: echon
keyword: execute
keyword: finish
keyword: function
keyword: endfunction
keyword: highlight
keyword: hi
keyword: let
keyword: const
keyword: map
keyword: nmap
keyword: imap
keyword: vmap
keyword: xmap
keyword: omap
keyword: cmap
keyword: smap
keyword: nnoremap
keyword: inoremap
keyword: vnoremap
keyword: xnoremap
keyword: onoremap
keyword: cnoremap
keyword: nunmap
keyword: iunmap
keyword: vunmap
keyword: xunmap
keyword: cmap
keyword: normal
keyword: set
keyword: setlocal
keyword: setglobal
keyword: silent
keyword: source
keyword: runtime
keyword: syntax
keyword: unlet
keyword: unlockvar
keyword: lockvar
keyword: var
keyword: import
keyword: export
keyword: class
keyword: enum
keyword: interface

# Scope prefixes g: s: l: a: v: b: w: t:
prefix: control g:
prefix: control s:
prefix: control l:
prefix: control a:
prefix: control v:
prefix: control b:
prefix: control w:
prefix: control t:

# Option references &option
prefix: control &

# Strings
string: " "
string: ' '

# Comments
line_comment: "

# Constants
constant: v:true
constant: v:false
constant: v:null
constant: v:none
