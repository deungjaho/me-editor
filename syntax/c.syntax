# C syntax definition for mg
# Place in ~/.mg/syntax/c.syntax

flags: fixed_types

# Preprocessor directives
# Conditional compilation = control flow (rose/magenta)
control: #if
control: #ifdef
control: #ifndef
control: #elif
control: #else
control: #endif
# Other directives = declarations (sand)
keyword: #include
keyword: #define
keyword: #undef
keyword: #pragma
keyword: #error
keyword: #warning
keyword: #line

# Keywords
keyword: auto
keyword: const
keyword: enum
keyword: extern
keyword: inline
keyword: register
keyword: restrict
keyword: sizeof
keyword: static
keyword: struct
keyword: typedef
keyword: union
keyword: volatile
keyword: _Bool
keyword: _Complex
keyword: _Imaginary

# Control flow keywords (rose/magenta)
control: break
control: case
control: continue
control: default
control: do
control: else
control: for
control: goto
control: if
control: return
control: switch
control: while

# Critical fixed-width & system boundary types (highlighted blue)
# u8..u64, i8..i64, s8..s64 are automatically matched by flags: fixed_types
type: int8_t
type: int16_t
type: int32_t
type: int64_t
type: uint8_t
type: uint16_t
type: uint32_t
type: uint64_t
type: size_t
type: ssize_t
type: ptrdiff_t
type: intptr_t
type: uintptr_t

# General types (neutral sand to reduce noise)
keyword: char
keyword: double
keyword: float
keyword: int
keyword: long
keyword: short
keyword: signed
keyword: unsigned
keyword: void
keyword: FILE
keyword: wchar_t

# Strings
string: " "
string: ' '

# Comments
line_comment: //
block_comment: /* */

# Constants
constant: true
constant: false
constant: TRUE
constant: FALSE
constant: NULL
