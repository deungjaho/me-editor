# Rust syntax definition for me

flags: lifetime fixed_types

# Control flow, State Mutation & Async (Key Intent for Rust)
control: break
control: continue
control: else
control: for
control: if
control: loop
control: match
control: return
control: while
control: await
control: async
control: yield
control: try
control: mut
control: unsafe

# Declarations & Structure Keywords
keyword: as
keyword: box
keyword: const
keyword: crate
keyword: dyn
keyword: enum
keyword: extern
keyword: fn
keyword: impl
keyword: in
keyword: let
keyword: mod
keyword: move
keyword: pub
keyword: ref
keyword: self
keyword: Self
keyword: static
keyword: struct
keyword: super
keyword: trait
keyword: type
keyword: use
keyword: where

# Core Primitive Non-Numeric Types (Numeric u8..u128, i8..i128 handled by fixed_types)
type: bool
type: char
type: usize
type: isize

# Strings
string: " "
string: ' '

# Comments
line_comment: //
block_comment: /* */

# Constants
constant: true
constant: false
