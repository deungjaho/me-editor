# Shell syntax definition for me

flags: dollar_vars pair_squote

# Variable / Process Expansion (Key Intent for Shell)
prefix: string $

# Control flow & Process termination (rose/magenta)
control: break
control: case
control: continue
control: do
control: done
control: elif
control: else
control: esac
control: fi
control: for
control: if
control: in
control: return
control: then
control: until
control: while
control: select
control: exit
control: trap
control: exec

# Shell Keywords & Builtins
keyword: function
keyword: alias
keyword: export
keyword: local
keyword: readonly
keyword: declare
keyword: typeset
keyword: let
keyword: unset
keyword: source
keyword: eval
keyword: set
keyword: shift
keyword: umask
keyword: wait
keyword: getopts
keyword: hash
keyword: history
keyword: jobs
keyword: disown
keyword: bg
keyword: fc
keyword: bind
keyword: builtin
keyword: command
keyword: compgen
keyword: complete
keyword: dirs
keyword: enable
keyword: help
keyword: popd
keyword: pushd
keyword: shopt
keyword: type
keyword: ulimit

# Shell Builtin Commands (neutral sand)
keyword: test
keyword: echo
keyword: printf
keyword: read
keyword: cd
keyword: pwd

# Strings
string: " "
string: ' '
string: ` `

# Comments
line_comment: #
