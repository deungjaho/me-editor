# Emacs Lisp syntax definition for me

flags: hyphen_words char_lit

# Control flow, Exceptions & Scoping (Key Intent for Elisp)
control: if
control: cond
control: when
control: unless
control: while
control: dolist
control: dotimes
control: catch
control: throw
control: condition-case
control: unwind-protect
control: signal
control: error
control: user-error
control: warn

# Core Definition Forms & Macro Keywords
keyword: defun
keyword: defmacro
keyword: defvar
keyword: defcustom
keyword: defconst
keyword: defvar-local
keyword: defalias
keyword: defsubst
keyword: defgeneric
keyword: defmethod
keyword: defclass
keyword: defstruct
keyword: cl-defun
keyword: cl-defmacro
keyword: cl-defstruct
keyword: let
keyword: let*
keyword: lambda
keyword: quote
keyword: function
keyword: setq
keyword: setq-default
keyword: setq-local
keyword: interactive
keyword: save-excursion
keyword: save-restriction
keyword: save-window-excursion
keyword: save-current-buffer
keyword: with-current-buffer
keyword: with-temp-buffer
keyword: with-eval-after-load
keyword: prog1
keyword: prog2
keyword: progn
keyword: require
keyword: provide
keyword: load
keyword: use-package

# Constants (Boolean & Nil literals, unified cyan)
constant: t
constant: nil

# Strings
string: " "
string: ' '

# Comments
line_comment: ;
