# Python syntax definition for me

flags: annotations pair_squote

# Control flow, Async, Exceptions & Context Managers (Key Intent for Python)
control: async
control: await
control: break
control: case
control: continue
control: elif
control: else
control: except
control: finally
control: for
control: if
control: match
control: raise
control: return
control: try
control: while
control: with
control: yield
control: assert

# Keywords & Declarations
keyword: as
keyword: class
keyword: def
keyword: del
keyword: from
keyword: global
keyword: import
keyword: in
keyword: is
keyword: lambda
keyword: nonlocal
keyword: not
keyword: or
keyword: pass
keyword: and

# Core object references (highlighted blue)
type: self
type: cls

# Standard types & built-in functions (neutral to eliminate noise)
keyword: int
keyword: str
keyword: float
keyword: bool
keyword: list
keyword: dict
keyword: tuple
keyword: set
keyword: bytes
keyword: object
keyword: type
keyword: frozenset
keyword: complex
keyword: bytearray
keyword: range
keyword: print
keyword: len
keyword: open
keyword: input
keyword: map
keyword: filter
keyword: zip
keyword: enumerate
keyword: sorted
keyword: reversed

# Strings (single and triple-quoted)
string: """ """
string: ''' '''
string: " "
string: ' '

# Comments
line_comment: #

# Constants
constant: True
constant: False
constant: None
