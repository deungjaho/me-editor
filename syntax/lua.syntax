# Lua syntax definition for me

# Control flow & Coroutines (Key Intent for Lua)
control: break
control: do
control: else
control: elseif
control: end
control: for
control: goto
control: if
control: in
control: repeat
control: return
control: then
control: until
control: while

# Keywords & Declarations
keyword: and
keyword: function
keyword: local
keyword: not
keyword: or
keyword: require

# Standard library (neutral to reduce noise)
keyword: assert
keyword: collectgarbage
keyword: coroutine
keyword: dofile
keyword: error
keyword: getmetatable
keyword: io
keyword: ipairs
keyword: load
keyword: math
keyword: next
keyword: os
keyword: package
