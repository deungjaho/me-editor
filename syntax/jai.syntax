# Jai syntax definition for me

flags: fixed_types

# Control flow #directives (rose/magenta)
control: #if
control: #else
control: #elseif
control: #endif
control: #while
control: #for
control: #loop
control: #return
control: #break
control: #continue
control: #through

# Keywords
keyword: defer
keyword: #import
keyword: #load
keyword: #export
keyword: #struct
keyword: #enum
keyword: #union
keyword: #type
keyword: #cast
keyword: #as
keyword: #insert
keyword: #bake
keyword: #place
keyword: #no_abc
keyword: #no_safety
keyword: #compiler
keyword: #scope
keyword: #scope_exit
keyword: #scope_file
keyword: #deprecated
keyword: #must
keyword: #inline
keyword: #no_inline
keyword: #init
keyword: #main
keyword: #assert
keyword: #message
keyword: #error
keyword: #warning
keyword: #string
keyword: #char
keyword: #int
keyword: #float
keyword: #bool
keyword: #void
keyword: #any
keyword: #code
keyword: #in
keyword: #out
keyword: #inout
keyword: #c_vararg
keyword: #call
keyword: #call_location
keyword: #this
keyword: #self
keyword: #context
keyword: #default
keyword: #none
keyword: #complete
keyword: #incomplete
keyword: #no_implicit
keyword: #named
keyword: #optional
keyword: #overload
keyword: #operator
keyword: #only
keyword: #except
keyword: #using
keyword: #first
keyword: #last
keyword: #before
keyword: #after
keyword: #add
keyword: #remove
keyword: #clear
keyword: #free
keyword: #alloc
keyword: #resize
keyword: #size_of
keyword: #type_of
keyword: #count_of
keyword: #min
keyword: #max
keyword: #abs
keyword: #clamp
keyword: #random
keyword: #random_seed
keyword: #random_next

# Control flow
control: if
control: else
control: elseif
control: while
control: for
control: return
control: break
control: continue
control: case
control: try
control: catch
control: finally

# Essential types (exact width types u8..u64, s8..s64, float32/64 matched by fixed_types)
type: bool
type: void

# General / Standard Container types (neutral to reduce noise)
keyword: int
keyword: uint
keyword: float
keyword: string
keyword: String
keyword: Type
keyword: Code
keyword: Any
keyword: Array
keyword: Dynamic_Array
keyword: Table
keyword: Context
keyword: Allocator

# Strings
string: " "
string: ' '

# Comments
line_comment: //
block_comment: /* */
