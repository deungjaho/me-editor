# PHP syntax definition for me

flags: dollar_vars

# File Inclusion, Execution & Control Flow (Key Intent for PHP)
control: require
control: require_once
control: include
control: include_once
control: break
control: case
control: continue
control: default
control: do
control: else
control: elseif
control: for
control: foreach
control: if
control: return
control: switch
control: match
control: throw
control: try
control: catch
control: finally
control: while
control: yield
control: goto

# Declarations & Keywords
keyword: abstract
keyword: as
keyword: callable
keyword: class
keyword: clone
keyword: const
keyword: declare
keyword: echo
keyword: empty
keyword: enddeclare
keyword: endfor
keyword: endforeach
keyword: endif
keyword: endswitch
keyword: endwhile
keyword: enum
keyword: extends
keyword: final
keyword: fn
keyword: function
keyword: global
keyword: implements
keyword: instanceof
keyword: insteadof
keyword: interface
keyword: isset
keyword: list
keyword: namespace
keyword: new
keyword: print
keyword: private
keyword: protected
keyword: public
keyword: readonly
keyword: static
keyword: trait
keyword: unset
keyword: use
keyword: var

# Types / Builtins (neutral sand to eliminate noise in type hints)
keyword: bool
keyword: int
keyword: float
keyword: string
keyword: array
keyword: object
keyword: mixed
keyword: void
keyword: never
keyword: parent
keyword: self
keyword: static

# Strings
string: " "
string: ' '

# Comments
line_comment: //
line_comment: #
block_comment: /* */

# Constants
constant: true
constant: false
constant: null
