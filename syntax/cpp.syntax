# C++ syntax definition for me
# Place in ~/.me-syntax/cpp.syntax

flags: fixed_types

# Preprocessor directives
# Conditional compilation = control flow (rose/magenta)
control: #if
control: #ifdef
control: #ifndef
control: #elif
control: #else
control: #endif
# Other directives = declarations (sand)
keyword: #include
keyword: #define
keyword: #undef
keyword: #pragma
keyword: #error
keyword: #warning
keyword: #line
keyword: #import

# Control flow keywords (rose/magenta)
control: break
control: case
control: catch
control: continue
control: co_await
control: co_return
control: co_yield
control: default
control: do
control: else
control: for
control: goto
control: if
control: return
control: switch
control: throw
control: try
control: while

# Keywords
keyword: alignas
keyword: alignof
keyword: asm
keyword: auto
keyword: class
keyword: concept
keyword: const
keyword: consteval
keyword: constexpr
keyword: constinit
keyword: decltype
keyword: delete
keyword: enum
keyword: explicit
keyword: export
keyword: extern
keyword: friend
keyword: inline
keyword: mutable
keyword: namespace
keyword: new
keyword: noexcept
keyword: operator
keyword: private
keyword: protected
keyword: public
keyword: register
keyword: requires
keyword: restrict
keyword: sizeof
keyword: static
keyword: static_assert
keyword: struct
keyword: template
keyword: this
keyword: thread_local
keyword: typedef
keyword: typeid
keyword: typename
keyword: union
keyword: using
keyword: virtual
keyword: volatile
keyword: wchar_t

# Casts (highlighted blue)
type: static_cast
type: dynamic_cast
type: reinterpret_cast
type: const_cast

# Fixed-width & system boundary types
type: int8_t
type: int16_t
type: int32_t
type: int64_t
type: uint8_t
type: uint16_t
type: uint32_t
type: uint64_t
type: size_t
type: ssize_t
type: ptrdiff_t
type: intptr_t
type: uintptr_t

# General types (neutral sand to reduce noise)
keyword: bool
keyword: char
keyword: char8_t
keyword: char16_t
keyword: char32_t
keyword: double
keyword: float
keyword: int
keyword: long
keyword: short
keyword: signed
keyword: unsigned
keyword: void
keyword: FILE
keyword: override
keyword: final

# Standard library types & utilities (neutral to reduce noise)
keyword: std
keyword: string
keyword: string_view
keyword: vector
keyword: array
keyword: map
keyword: unordered_map
keyword: set
keyword: unordered_set
keyword: pair
keyword: tuple
keyword: optional
keyword: variant
keyword: any
keyword: span
keyword: function
keyword: unique_ptr
keyword: shared_ptr
keyword: weak_ptr
keyword: move
keyword: forward
keyword: swap
keyword: cout
keyword: cerr
keyword: cin
keyword: endl
keyword: nullptr_t

# Strings
string: " "
string: ' '

# Comments
line_comment: //
block_comment: /* */

# Constants
constant: true
constant: false
constant: TRUE
constant: FALSE
constant: NULL
constant: nullptr
