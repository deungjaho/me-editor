control: break
control: case
control: chan
control: continue
control: default
control: defer
control: else
control: fallthrough
control: for
control: go
control: goto
control: if
control: panic
control: recover
control: return
control: select
control: switch

# Declaration & Structuring Keywords
keyword: const
keyword: func
keyword: import
keyword: interface
keyword: map
keyword: package
keyword: range
keyword: struct
keyword: type
keyword: var
keyword: iota

